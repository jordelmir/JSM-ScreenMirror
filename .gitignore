# ============================================
# ELYSIUM VANGUARD — Production .gitignore
# ============================================

# ══════════════════════════════════════════════
#  SECRETS & CREDENTIALS — CRITICAL PROTECTION
# ══════════════════════════════════════════════
*.pem
*.key
*.p12
*.p8
*.cer
*.der
*.crt
*.pfx
*.mobileprovision
*.keystore
*.jks
signing.properties
keystore.properties
local.properties
gradle.properties
google-services.json
GoogleService-Info.plist
*.env
.env
.env.*
.env.local
.env.production
.secret
*.secret
secrets/
credentials/
api_keys.txt

# ══════════════════════════════════════════════
#  BUILD OUTPUTS
# ══════════════════════════════════════════════
# macOS
.build/
DerivedData/
*.xcodeproj/xcuserdata/
*.xcworkspace/xcuserdata/
*.dSYM
*.dSYM.zip
*.app

# Android
build/
*.apk
*.aab
*.aar
*.hprof

# ══════════════════════════════════════════════
#  GRADLE
# ══════════════════════════════════════════════
.gradle/
!gradle-wrapper.jar
!gradle-wrapper.properties

# ══════════════════════════════════════════════
#  SWIFT PACKAGE MANAGER
# ══════════════════════════════════════════════
.swiftpm/
Package.resolved

# ══════════════════════════════════════════════
#  IDE FILES
# ══════════════════════════════════════════════
.idea/
*.iml
.vscode/
*.swp
*.swo
*~
*.code-workspace

# ══════════════════════════════════════════════
#  OS FILES
# ══════════════════════════════════════════════
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# ══════════════════════════════════════════════
#  LOGS & TEMP
# ══════════════════════════════════════════════
*.log
/tmp/
*.tmp
*.bak
*.orig

# ══════════════════════════════════════════════
#  DEPENDENCIES
# ══════════════════════════════════════════════
node_modules/
Pods/
Carthage/

# ══════════════════════════════════════════════
#  RELEASE ARTIFACTS (stored in GitHub Releases)
# ══════════════════════════════════════════════
releases/
